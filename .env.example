# App
APP_URL=http://localhost:3000

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-strong-secret-here

# MongoDB (URI is assembled in utils/db.ts)
DB_USER=
DB_PASSWORD=
